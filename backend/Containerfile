# Dockerfile for Enterprise Operations Backend (FastAPI)
FROM docker.io/library/python:3.11-slim AS builder

LABEL maintainer="Operations Platform Engineering Team"
LABEL description="FastAPI Backend Service for Enterprise Operations Platform"

WORKDIR /app

# Install build dependencies
RUN apt-get -o Acquire::ForceIPv4=true update \
    && apt-get -o Acquire::ForceIPv4=true install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt

# Final runtime stage
FROM docker.io/library/python:3.11-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get -o Acquire::ForceIPv4=true update \
    && apt-get -o Acquire::ForceIPv4=true install -y --no-install-recommends \
        libpq5 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Copy installed dependencies to a path traversable by the non-root runtime user
COPY --from=builder /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Copy application source code
COPY . .

# Add non-root user and drop privileges
RUN addgroup --system --gid 1001 app \
    && adduser --system --uid 1001 --ingroup app app \
    && chown -R app:app /app

# Expose FastAPI port
EXPOSE 8000

# Drop to non-root user before running the service
USER app

# Default startup command
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
