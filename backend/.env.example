# Application Settings
PROJECT_NAME="3-Workflow Operations & Faculty Governance Platform"
API_V1_STR="/api/v1"
ENVIRONMENT=development
DEBUG=False
PORT=8000

# Security & Authentication - MUST be set in production
SECRET_KEY=your-super-secret-jwt-key-min-32-chars-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Settings - MUST be set
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-db-password
POSTGRES_DB=ops_db
DATABASE_URL=postgresql://postgres:your-secure-db-password@db:5432/ops_db

# CORS Configuration (comma-separated origins) - Set explicitly for production
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional External FMS Integration - Set if using FMS
FMS_API_BASE_URL=
FMS_API_KEY=

# Redis cache and rate limiting
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Account Lockout
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15

# Password Policy
MIN_PASSWORD_LENGTH=12
REQUIRE_UPPERCASE=true
REQUIRE_LOWERCASE=true
REQUIRE_NUMBERS=true
REQUIRE_SPECIAL_CHARS=true

# Microsoft Graph app-only email settings
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=noreply@yourdomain.com
EMAIL_FROM_NAME=Enterprise Ops Platform
FRONTEND_URL=http://localhost:3000
