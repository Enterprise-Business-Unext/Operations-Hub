# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=ops_db
POSTGRES_SERVER=db
POSTGRES_PORT=5432

# Redis cache and rate limiting
REDIS_PASSWORD=
REDIS_DB=0

# Backend Service
SECRET_KEY=
ENVIRONMENT=production
DEBUG=False
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=[]

# Frontend Service
NEXT_PUBLIC_API_URL=/api/v1

# Nginx reverse proxy
NGINX_BIND_ADDRESS=127.0.0.1
NGINX_PORT=8080

# EC2 production deployment
GHCR_IMAGE_PREFIX=ghcr.io/your-org/operations-hub
DOMAIN_NAME=app.example.com

# Optional Docker frontend development server
FRONTEND_DEV_PORT=3000
FRONTEND_DEV_API_URL=http://localhost:8000/api/v1

# Microsoft Graph app-only email delivery
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER_EMAIL=
EMAIL_FROM_NAME=Enterprise Ops Platform
FRONTEND_URL=https://app.example.com
